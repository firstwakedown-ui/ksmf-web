---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Kroměřížská 2026">
  <header class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span aria-hidden="true">✦</span> Tradice od roku 2005</p>
      <h1>Kroměřížská <span>2026</span> bude!</h1>
      <p class="hero-lead">Prodloužený víkend plný starých přátel, nových tváří, her a pohody v srdci Kroměříže.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/prihlaska/">Chci se přihlásit <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href="#informace">Praktické informace</a>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <span class="year">2026</span>
      <span class="orbit orbit-one"></span>
      <span class="orbit orbit-two"></span>
      <span class="symbol">K</span>
    </div>
  </header>

  <section class="intro" aria-labelledby="o-akci">
    <div class="section-heading">
      <p class="eyebrow">O akci</p>
      <h2 id="o-akci">Místo, kde se generace ŠMFáků znovu potkávají</h2>
      <p>KŠMF, známá také jako Kroměřížská, je neoficiální sraz minulých i současných účastníků a organizátorů.</p>
    </div>
    <div class="feature-grid">
      <article class="feature-card">
        <span class="feature-icon" aria-hidden="true">∞</span>
        <h3>Mezigenerační setkání</h3>
        <p>Od středoškoláků přes matfyzáky až po pracující. Tradice od roku 2005 nás drží pohromadě.</p>
      </article>
      <article class="feature-card">
        <span class="feature-icon" aria-hidden="true">♟</span>
        <h3>Příjemná dovolená</h3>
        <p>Deskovky, šarády, zámecké zahrady a nenucený program, do kterého se můžeš zapojit po svém.</p>
      </article>
      <article class="feature-card">
        <span class="feature-icon" aria-hidden="true">♡</span>
        <h3>Pro všechny ŠMFáky</h3>
        <p>Věk, zvyky ani odlišnosti nejsou překážkou. Jsme otevření nové společnosti a nekoušeme.</p>
      </article>
    </div>
  </section>

  <section id="informace" class="event-section" aria-labelledby="informace-title">
    <div class="section-heading compact">
      <p class="eyebrow">Kdy, kde a za kolik</p>
      <h2 id="informace-title">Praktické informace</h2>
    </div>
    <div id="info" class="info-grid" aria-live="polite" aria-busy="true">
      <div class="info-loading"><span class="loader" aria-hidden="true"></span> Načítám aktuální informace…</div>
    </div>
  </section>

  <section class="practical-grid" aria-label="Co s sebou a stravování">
    <article class="packing-card">
      <div class="card-copy">
        <p class="eyebrow">Ať nic nechybí</p>
        <h2>Co s sebou?</h2>
        <p>Klasickou ŠMF výbavu. Zdůrazníme hlavně následující nezbytnosti:</p>
        <ul class="packing-list">
          <li><span aria-hidden="true">✓</span> šátek</li>
          <li><span aria-hidden="true">✓</span> bábovku nebo buchtu</li>
          <li><span aria-hidden="true">✓</span> přezůvky a spacák</li>
        </ul>
        <p class="muted">Karimatek netřeba, máme karimatrace.</p>
      </div>
    </article>

    <article class="food-card">
      <a class="food-photo" href="/fotky/jidlobig.jpg" target="_blank" rel="noreferrer" aria-label="Zvětšit fotografii jídla">
        <img src="/fotky/jidlo.jpg" alt="Ukázka jídla na Kroměřížské" loading="lazy" decoding="async" />
        <span aria-hidden="true">Zobrazit foto ↗</span>
      </a>
      <div class="card-copy">
        <p class="eyebrow">Nebudeme o hladu</p>
        <h2>Jídlo</h2>
        <p>Snídaně budou formou chleba plus něco na něj, pravděpodobně také pomazánky. Obědy nejspíš domluvíme v restauraci a o večeře se postará Mára.</p>
      </div>
    </article>
  </section>

  <section class="closing">
    <div>
      <p class="eyebrow">Tak co, uvidíme se?</p>
      <h2>Těšíme se na Tebe v Kroměříži!</h2>
      <p>Vaši orgové</p>
    </div>
    <a class="button button-primary" href="/prihlaska/">Vyplnit přihlášku <span aria-hidden="true">→</span></a>
  </section>

  <script>
    import { supabase } from '../lib/supabase';

    const target = document.querySelector('#info');
    const showMessage = (message) => {
      if (!target) return;
      target.setAttribute('aria-busy', 'false');
      target.innerHTML = `<p class="info-message">${message}</p>`;
    };

    if (target && !supabase) {
      showMessage('Aktuální informace zatím nejsou k dispozici. Zkuste to prosím později.');
    } else if (target && supabase) {
      const { data, error } = await supabase
        .from('event_info')
        .select('venue, map_url, starts_at, ends_at, price_text')
        .eq('id', 1)
        .single();

      if (error || !data) {
        showMessage('Aktuální informace se nepodařilo načíst. Zkuste to prosím později.');
      } else {
        const escapeHtml = (value) => String(value ?? 'Bude upřesněno').replace(/[&<>"']/g, (character) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;'
        })[character]);
        const mapUrl = typeof data.map_url === 'string' && /^https?:\/\//i.test(data.map_url)
          ? data.map_url
          : null;
        const venue = escapeHtml(data.venue);
        const venueContent = mapUrl
          ? `${venue}<a class="info-link" href="${escapeHtml(mapUrl)}" target="_blank" rel="noreferrer">Otevřít mapu <span aria-hidden="true">↗</span></a>`
          : venue;

        target.setAttribute('aria-busy', 'false');
        target.innerHTML = `
          <article class="info-card info-card-wide">
            <span class="info-icon" aria-hidden="true">⌖</span>
            <div><span class="info-label">Místo konání</span><strong>${venueContent}</strong></div>
          </article>
          <article class="info-card">
            <span class="info-icon" aria-hidden="true">→</span>
            <div><span class="info-label">Začátek</span><strong>${escapeHtml(data.starts_at)}</strong></div>
          </article>
          <article class="info-card">
            <span class="info-icon" aria-hidden="true">←</span>
            <div><span class="info-label">Konec</span><strong>${escapeHtml(data.ends_at)}</strong></div>
          </article>
          <article class="info-card">
            <span class="info-icon" aria-hidden="true">Kč</span>
            <div><span class="info-label">Cena</span><strong>${escapeHtml(data.price_text)}</strong></div>
          </article>
        `;
      }
    }
  </script>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(240px, .65fr);
    min-height: 430px;
    padding: clamp(2rem, 6vw, 4.5rem);
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(circle at 78% 22%, rgb(255 255 255 / 18%), transparent 18rem),
      linear-gradient(135deg, #312e81 0%, #4f46e5 52%, #0284c7 100%);
    border-radius: 1rem;
  }
  .hero::after {
    content: "";
    position: absolute;
    right: -8%;
    bottom: -40%;
    width: 28rem;
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 50%;
  }
  .hero-copy { position: relative; z-index: 2; align-self: center; }
  .eyebrow {
    margin: 0 0 .65rem;
    color: var(--accent-strong);
    font-size: .75rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .hero .eyebrow { color: #c7d2fe; }
  .hero h1 {
    max-width: 650px;
    margin: 0;
    color: #fff;
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    line-height: .95;
  }
  .hero h1 span { display: block; color: #bae6fd; font-size: .72em; }
  .hero-lead { max-width: 560px; margin: 1.5rem 0 0; color: #e0e7ff; font-size: clamp(1rem, 2vw, 1.2rem); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .55rem;
    min-height: 46px;
    padding: .72rem 1.05rem;
    border: 1px solid transparent;
    border-radius: .7rem;
    text-decoration: none;
    transition: transform .18s ease, background-color .18s ease, box-shadow .18s ease;
  }
  .button:hover { transform: translateY(-2px); }
  .button-primary { color: #312e81; background: #fff; box-shadow: 0 12px 28px rgb(15 23 42 / 22%); }
  .button-primary:hover { color: #312e81; background: #eef2ff; }
  .button-secondary { color: #fff; background: rgb(255 255 255 / 10%); border-color: rgb(255 255 255 / 30%); }
  .button-secondary:hover { color: #fff; background: rgb(255 255 255 / 18%); }
  .hero-art { position: relative; z-index: 1; display: grid; place-items: center; min-height: 260px; }
  .symbol {
    display: grid;
    place-items: center;
    width: 9rem;
    aspect-ratio: 1;
    color: #4338ca;
    background: rgb(255 255 255 / 92%);
    border-radius: 2.4rem;
    box-shadow: 0 25px 60px rgb(15 23 42 / 25%);
    font-size: 4.5rem;
    font-weight: 900;
    transform: rotate(-7deg);
  }
  .year { position: absolute; top: 5%; right: 0; color: rgb(255 255 255 / 30%); font-size: 2rem; font-weight: 900; }
  .orbit { position: absolute; border: 1px solid rgb(255 255 255 / 24%); border-radius: 50%; }
  .orbit-one { width: 15rem; aspect-ratio: 1; }
  .orbit-two { width: 20rem; aspect-ratio: 1; }

  .intro, .event-section { margin: clamp(3.5rem, 8vw, 6rem) 0; }
  .section-heading { max-width: 650px; margin-bottom: 2rem; }
  .section-heading.compact { margin-bottom: 1.5rem; }
  .section-heading h2, .card-copy h2, .closing h2 { margin: 0; font-size: clamp(1.55rem, 3vw, 2.2rem); }
  .section-heading > p:last-child { color: var(--muted); font-size: 1rem; }
  .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .feature-card {
    margin: 0;
    padding: 1.5rem;
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 1rem;
    box-shadow: 0 10px 30px rgb(15 23 42 / 5%);
    transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
  }
  .feature-card:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--accent) 38%, var(--border)); box-shadow: 0 18px 36px rgb(15 23 42 / 9%); }
  .feature-card h3 { margin: 1rem 0 .45rem; font-size: 1.02rem; }
  .feature-card p { margin: 0; color: var(--muted); }
  .feature-icon, :global(.info-icon) {
    display: grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    color: var(--accent-strong);
    background: var(--accent-soft);
    border-radius: .75rem;
    font-size: 1.25rem;
    font-weight: 800;
  }

  .event-section { padding: clamp(1.5rem, 4vw, 2.5rem); background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--border)); border-radius: 1rem; }
  .info-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .8rem; }
  .info-loading, :global(.info-message) { grid-column: 1 / -1; margin: 0; padding: 1.25rem; color: var(--muted); background: var(--paper); border-radius: .8rem; }
  .loader { display: inline-block; width: .9rem; height: .9rem; margin-right: .5rem; vertical-align: -.1rem; border: 2px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: spin .7s linear infinite; }
  :global(.info-card) { display: flex; align-items: center; gap: .9rem; min-width: 0; margin: 0; padding: 1.15rem; background: var(--paper); border: 1px solid var(--border); border-radius: .85rem; box-shadow: 0 8px 22px rgb(15 23 42 / 5%); }
  :global(.info-card-wide) { grid-column: 1 / -1; }
  :global(.info-card > div) { display: grid; min-width: 0; gap: .15rem; }
  :global(.info-label) { color: var(--muted); font-size: .72rem; font-weight: 750; letter-spacing: .07em; text-transform: uppercase; }
  :global(.info-card strong) { overflow-wrap: anywhere; font-size: .96rem; }
  :global(.info-link) { display: block; margin-top: .3rem; font-size: .78rem; }

  .practical-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 0; }
  .packing-card, .food-card { margin: 0; padding: 0; overflow: hidden; background: var(--paper); border: 1px solid var(--border); border-radius: 1rem; box-shadow: 0 12px 32px rgb(15 23 42 / 6%); }
  .card-copy { padding: clamp(1.4rem, 3vw, 2rem); }
  .card-copy > p:not(.eyebrow) { color: var(--muted); }
  .packing-list { display: grid; gap: .55rem; margin: 1.2rem 0; padding: 0; list-style: none; }
  .packing-list li { display: flex; align-items: center; gap: .6rem; font-weight: 700; }
  .packing-list span { display: grid; place-items: center; width: 1.4rem; height: 1.4rem; color: var(--accent-strong); background: var(--accent-soft); border-radius: 50%; font-size: .72rem; }
  .muted { font-size: .82rem; }
  .food-photo { position: relative; display: block; overflow: hidden; color: #fff; }
  .food-photo img { display: block; width: 100%; height: 210px; object-fit: cover; transition: transform .35s ease; }
  .food-photo span { position: absolute; right: .8rem; bottom: .8rem; padding: .4rem .6rem; background: rgb(15 23 42 / 72%); border-radius: .45rem; font-size: .72rem; }
  .food-photo:hover img { transform: scale(1.035); }

  .closing { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin: clamp(3.5rem, 8vw, 6rem) 0 1rem; padding: clamp(1.5rem, 4vw, 2.5rem); color: #fff; background: linear-gradient(135deg, #1e1b4b, #4338ca); border-radius: 1rem; }
  .closing h2 { color: #fff; }
  .closing p:not(.eyebrow) { margin-bottom: 0; color: #c7d2fe; }
  .closing .eyebrow { color: #a5b4fc; }

  @keyframes spin { to { transform: rotate(360deg); } }
  @media (max-width: 780px) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    .hero-art { display: none; }
    .feature-grid { grid-template-columns: 1fr; }
    .practical-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .hero { padding: 2rem 1.25rem; }
    .hero-actions, .hero-actions .button { width: 100%; }
    .info-grid { grid-template-columns: 1fr; }
    :global(.info-card-wide) { grid-column: auto; }
    .closing { align-items: stretch; flex-direction: column; }
    .closing .button { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .button, .feature-card, .food-photo img { transition: none; }
    .loader { animation: none; }
    .button:hover, .feature-card:hover { transform: none; }
  }
</style>
