---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Účastníci">
  <h1>Účastníci</h1>
  <p>
    Tady se můžeš podívat, kdo už je přihlášený. Přes&nbsp;<a href="/diskuze/">diskuzi</a> se můžete domluvit třeba na společné cestě.
  </p>

  <div id="attendees" class="attendees" aria-live="polite" aria-busy="true">
    <p class="status">Načítám seznam účastníků…</p>
  </div>

  <script>
    import { supabase } from '../../lib/supabase';

    const target = document.querySelector('#attendees');

    const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (character) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    })[character]);

    const formatDate = (value) => new Intl.DateTimeFormat('cs-CZ', {
      dateStyle: 'medium'
    }).format(new Date(value));

    if (!supabase) {
      target.setAttribute('aria-busy', 'false');
      target.innerHTML = '<p class="status status-error">Chybí nastavení Supabase.</p>';
    } else {
      const { data, error } = await supabase
        .from('public_attendees')
        .select('name, note, created_at')
        .order('name', { ascending: true });

      target.setAttribute('aria-busy', 'false');

      if (error) {
        target.innerHTML = '<p class="status status-error">Seznam účastníků se nepodařilo načíst.</p>';
      } else if (!data?.length) {
        target.innerHTML = '<p class="status">Zatím není přihlášený žádný účastník.</p>';
      } else {
        target.innerHTML = `
          <div class="table-wrap">
            <table class="attendee-table">
              <caption class="visually-hidden">Seznam přihlášených účastníků</caption>
              <thead>
                <tr>
                  <th scope="col">Jméno</th>
                  <th scope="col">Poznámka</th>
                  <th scope="col">Přihlášen(a)</th>
                </tr>
              </thead>
              <tbody>
                ${data.map((attendee) => `
                  <tr>
                    <th scope="row">${escapeHtml(attendee.name)}</th>
                    <td>${attendee.note ? escapeHtml(attendee.note) : '<span class="muted">—</span>'}</td>
                    <td><time datetime="${escapeHtml(attendee.created_at)}">${escapeHtml(formatDate(attendee.created_at))}</time></td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        `;
      }
    }
  </script>
</BaseLayout>

<style>
  .attendees { margin-top: 1.5rem; }

  :global(.status) {
    margin: 0;
    padding: 1rem 1.15rem;
    color: var(--muted);
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: .75rem;
  }

  :global(.status-error) { color: #b42318; }

  :global(.table-wrap) {
    width: 100%;
    overflow-x: auto;
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: .8rem;
    box-shadow: 0 8px 24px rgb(15 23 42 / 5%);
  }

  :global(.attendee-table) {
    width: 100%;
    min-width: 620px;
    border: 0;
    border-spacing: 0;
    border-collapse: collapse;
    background: var(--paper);
    font-size: .9rem;
    text-align: left;
  }

  :global(.attendee-table th),
  :global(.attendee-table td) {
    padding: .85rem 1rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  :global(.attendee-table thead th) {
    color: #fff;
    background: linear-gradient(135deg, #4f46e5, #6366f1);
    border-bottom-color: #4338ca;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .07em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  :global(.attendee-table tbody th) {
    width: 27%;
    color: var(--ink);
    font-weight: 700;
  }

  :global(.attendee-table tbody td:nth-child(2)) { width: 48%; }
  :global(.attendee-table tbody td:last-child) { width: 25%; white-space: nowrap; }
  :global(.attendee-table tbody tr:last-child > *) { border-bottom: 0; }
  :global(.attendee-table tbody tr:hover) { background: var(--accent-soft); }

  :global(.attendee-table time),
  :global(.muted) {
    color: var(--muted);
    font-size: .84rem;
    font-weight: 400;
  }

  :global(.visually-hidden) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    :global(.table-wrap) { border-radius: .65rem; }
    :global(.attendee-table th),
    :global(.attendee-table td) { padding: .72rem .8rem; }
  }
</style>